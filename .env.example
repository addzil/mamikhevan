APP_NAME=Mamikhevanshop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mamikhevan.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mamikhevan
DB_USERNAME=mamikhevan
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting generally has no always-on queue worker; deliver queued mail during the request.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.mamikhevan.com
MAIL_PORT=465
MAIL_USERNAME=account@mamikhevan.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="account@mamikhevan.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@mamikhevanshop.id
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Developer > Settings > API Key: Shipping Cost API.
KOMERCE_SHIPPING_COST_KEY=
# ID Desa Tambun, Tambun Selatan, Kabupaten Bekasi 17510 dari pencarian Komerce.
KOMERCE_ORIGIN_ID=
